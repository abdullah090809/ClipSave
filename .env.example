# ClipSave Client Environment Variables
# Note: Any variable prefixed with EXPO_PUBLIC_ is bundled into client code. Never store secrets here.

# Deployed Production Backend on SnapDeploy:
EXPO_PUBLIC_API_BASE_URL=https://clipsave-96518.containers.snapdeploy.app
EXPO_PUBLIC_BACKEND_URL=https://clipsave-96518.containers.snapdeploy.app

# For local development against a local FastAPI backend, set:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

EXPO_PUBLIC_ENABLE_MOCK_RESOLVER=false
