{
  "expo": {
    "name": "ClipSave",
    "slug": "clipsave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clipsave",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/clipsave-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1417"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clipsave.app"
    },
    "android": {
      "package": "com.clipsave.app",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/clipsave-logo.png",
        "backgroundColor": "#0B1417"
      },
      "permissions": [
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": {
            "mimeType": "text/plain"
          }
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ClipSave to access your gallery to save videos.",
          "savePhotosPermission": "Allow ClipSave to save videos to your gallery.",
          "granularPermissions": ["photo", "video"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
